# PRIVATE.txt and PUBLIC.txt are deliberately NOT ignored [U 2026-08-08]:
# the publication gate belongs at the remote, where visibility is switched.
# Only folders without a repository keep purely local markers.

# Local & Multi-Agent Locks
LOCK
LOCK.*
*.lock
LOCK.txt
LOCK.*.txt
LOCK.permissions.json
uv.lock
!package-lock.json
*.orig

# Multi-Host Sync Conflicts
*-conflict-*
* (kopie)*
* (copy)*
* (Kopie)*
* (Copy)*
*conflicted copy*
*-WORKSTATION*
*-WORKSTATION-LG*
*-WORKSTATION-LG.*
*-ASUS*
*-ASUS-GEI*
*-ASUS-GEI.*
*-LAPTOP*
*-Mac Studio*
*.sync-temp-*
*.sync-conflict-*
*.conflict

# Python caches, test and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.turbo/
.hypothesis/
wheelhouse/
.wheel-smoke/

# Environments
.venv/
venv/
ENV/
env/

# Distribution / Packaging
build/
dist/
*.egg-info/

